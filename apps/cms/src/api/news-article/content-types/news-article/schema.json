{
  "kind": "collectionType",
  "collectionName": "news_articles",
  "info": {
    "singularName": "news-article",
    "pluralName": "news-articles",
    "displayName": "News Article",
    "description": "新闻动态，点击跳转外部链接"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": false
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "externalUrl": {
      "type": "string",
      "required": true
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "required": false
    },
    "order": {
      "type": "integer",
      "required": false
    }
  }
}
