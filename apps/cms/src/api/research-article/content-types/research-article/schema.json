{
  "kind": "collectionType",
  "collectionName": "research_articles",
  "info": {
    "singularName": "research-article",
    "pluralName": "research-articles",
    "displayName": "Research Article",
    "description": "前沿研究文章，正文为富文本，点击进入站内详情页"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": false
    },
    "body": {
      "type": "richtext",
      "required": false
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "required": false
    },
    "order": {
      "type": "integer",
      "required": false
    }
  }
}
